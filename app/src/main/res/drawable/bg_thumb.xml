<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded backdrop of the card preview area; a thumbnail is clipped to it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/panel_alt" />
    <stroke
        android:width="1dp"
        android:color="@color/panel_border" />
    <corners android:radius="12dp" />
</shape>
